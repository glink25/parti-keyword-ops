{
  "partiVersion": "0.1.0",
  "protocolVersion": 1,
  "id": "keyword-ops",
  "name": "Keyword Ops",
  "version": "0.1.1",
  "description": "4–10 人双队词语联想对抗游戏。Captain 给出单词与数字提示，Field Agents 在 5×5 关键词板中协作找出己方目标并避开危险词。",
  "cover": "cover.svg",
  "packageMode": "filesystem",
  "entry": {
    "ui": "index.html",
    "worker": "room.worker.js"
  },
  "room": {
    "minPlayers": 4,
    "maxPlayers": 10
  },
  "sync": { "mode": "snapshot" },
  "permissions": {
    "network": false,
    "storage": "session"
  }
}
